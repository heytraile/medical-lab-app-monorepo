# Local Supabase CLI stack — COMMITTED ON PURPOSE.
#
# These keys are the CLI's fixed local demo credentials. They are byte-identical
# on every developer machine, are signed with the public well-known local JWT
# secret, and only ever reach a Postgres running in Docker on 127.0.0.1. They
# are NOT secrets. Real cloud credentials live in Doppler (drax-lis) — never
# put a hosted project's service_role key in this file.
#
# Loaded by scripts/with-local-supabase.sh (`pnpm dev:local`). Anything already
# exported in your shell takes precedence, so ad-hoc overrides work:
#   VITE_LIS_MODE=cloud pnpm dev:local
#
# Regenerate these values any time with: pnpm supabase:status

# --- Cloud API (apps/api) ---------------------------------------------------
API_PORT=3102
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Edge engine (apps/edge-engine) ----------------------------------------
EDGE_ENGINE_PORT=3101
DATABASE_URL=file:./dev.db
EDGE_NODE_ID=drax-hall-edge-1
CLOUD_API_URL=http://localhost:3102
CLOUD_SYNC_ENABLED=true

# Shared edge <-> cloud sync secret (same value both sides).
EDGE_SYNC_TOKEN=dev-edge-sync-token

# --- Web (apps/web) ---------------------------------------------------------
# Only VITE_* keys reach the browser.
VITE_LIS_MODE=edge
VITE_LIS_API_URL=http://localhost:3101
VITE_WS_URL=http://localhost:3101
VITE_CLOUD_API_URL=http://localhost:3102
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Analyzers / printer ----------------------------------------------------
SYSMEX_TCP_PORT=5001
MINDRAY_TCP_PORT=5003
IFLASH_TCP_PORT=5004
ZEBRA_PRINTER_HOST=127.0.0.1
ZEBRA_PRINTER_PORT=9100
