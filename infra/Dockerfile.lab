# Single-container lab mini PC image: edge-engine API + Socket.IO + SPA UI.
FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages ./packages
COPY apps/web ./apps/web
COPY apps/edge-engine ./apps/edge-engine
RUN pnpm install --filter @drax-lis/web... --filter @drax-lis/edge-engine... --frozen-lockfile=false
RUN pnpm --filter @drax-lis/contracts build
RUN pnpm --filter @drax-lis/protocols build
RUN pnpm --filter @drax-lis/catalog build
RUN pnpm --filter @drax-lis/edge-engine db:generate

FROM deps AS web-spa
ARG VITE_LIS_MODE=edge
ARG VITE_LIS_API_URL=
ARG VITE_WS_URL=
ARG VITE_CLOUD_API_URL=
ENV VITE_LIS_MODE=$VITE_LIS_MODE
ENV VITE_LIS_API_URL=$VITE_LIS_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_CLOUD_API_URL=$VITE_CLOUD_API_URL
WORKDIR /app/apps/web
RUN pnpm build:spa

FROM deps AS edge-build
WORKDIR /app/apps/edge-engine
RUN pnpm build
COPY --from=web-spa /app/apps/web/dist/client ./dist/public/ui

FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends sqlite3 \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV SERVE_WEB_UI=true
COPY --from=edge-build /app /app
WORKDIR /app/apps/edge-engine
RUN mkdir -p /data /backups
ENV DATABASE_URL=file:/data/edge.db
ENV BACKUP_DIR=/backups
EXPOSE 3101 5001 5003 5004
CMD ["sh", "-c", "pnpm db:push && node dist/main.js"]
