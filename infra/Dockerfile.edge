FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages ./packages
COPY apps/edge-engine ./apps/edge-engine
RUN pnpm install --filter @drax-lis/edge-engine... --frozen-lockfile=false
RUN pnpm --filter @drax-lis/contracts build
RUN pnpm --filter @drax-lis/protocols build
RUN pnpm --filter @drax-lis/edge-engine db:generate
RUN pnpm --filter @drax-lis/edge-engine build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app /app
WORKDIR /app/apps/edge-engine
RUN mkdir -p /data
ENV DATABASE_URL=file:/data/edge.db
EXPOSE 3101 5001 5003 5004
CMD ["sh", "-c", "pnpm db:push && node dist/main.js"]
