generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id             String     @id @default(cuid())
  /// Normalized medical record number — unique business key (upstream or TEMP…)
  mrn            String     @unique
  externalId     String?
  firstName      String
  middleName     String?
  lastName       String
  dateOfBirth    String?
  sex            String?
  /// active | quarantined
  status         String     @default("active")
  /// upstream | local_provisional
  identityOrigin String     @default("upstream")
  /// n_a | pending_upstream | synced | failed
  syncStatus     String     @default("n_a")
  /// Shared when multiple active patients share name+DOB+sex with different MRNs
  suspectGroupId String?
  source         String     @default("seed")
  rawImportJson  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  specimens      Specimen[]

  @@index([lastName, firstName])
  @@index([suspectGroupId])
  @@index([status])
  @@index([syncStatus])
}

model Specimen {
  id                     String    @id @default(cuid())
  accessionNumber        String    @unique
  barcode                String    @unique
  patientId              String?
  patientJson            String?
  /// Audit of identity confirmation when patient was in a suspect group
  identityConfirmationJson String?
  specimenType           String    @default("blood")
  orderedTestsJson       String    @default("[]")
  status                 String    @default("registered")
  collectedAt            DateTime?
  registeredAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  results                Result[]
  patient                Patient?  @relation(fields: [patientId], references: [id])

  @@index([barcode])
  @@index([patientId])
}

model Result {
  id              String   @id @default(cuid())
  accessionNumber String
  barcode         String
  analyzerId      String
  testCode        String
  testName        String?
  value           String
  units           String?
  referenceLow    Float?
  referenceHigh   Float?
  flag            String   @default("unknown")
  /// Clinical release workflow: pending_review → released (authorizer)
  status          String   @default("pending_review")
  observedAt      DateTime
  rawMessageId    String?
  createdAt       DateTime @default(now())
  specimen        Specimen? @relation(fields: [accessionNumber], references: [accessionNumber])
  rawMessage      RawMessage? @relation(fields: [rawMessageId], references: [id])

  @@index([barcode])
  @@index([analyzerId])
  @@index([status])
  @@index([accessionNumber, testCode, analyzerId])
}

model RawMessage {
  id          String   @id @default(cuid())
  analyzerId  String
  transport   String
  protocol    String
  payload     String
  receivedAt  DateTime @default(now())
  parsedOk    Boolean  @default(false)
  parseError  String?
  results     Result[]

  @@index([analyzerId, receivedAt])
}

model OutboxEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  type       String
  status     String   @default("pending")
  sequence   Int
  payload    String
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, sequence])
}

model SyncMeta {
  id    String @id @default("singleton")
  /// Monotonic sequence for outbox ordering
  nextSequence Int @default(1)
  /// YYYYMMDD for sequential accession counter
  accessionDay String @default("")
  accessionSeq Int    @default(0)
}
