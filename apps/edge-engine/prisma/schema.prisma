generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id             String     @id @default(cuid())
  /// Normalized medical record number — unique business key (upstream or TEMP…)
  mrn            String     @unique
  externalId     String?
  firstName      String
  middleName     String?
  lastName       String
  dateOfBirth    String?
  sex            String?
  /// active | quarantined
  status         String     @default("active")
  /// upstream | local_provisional
  identityOrigin String     @default("upstream")
  /// n_a | pending_upstream | synced | failed
  syncStatus     String     @default("n_a")
  /// Shared when multiple active patients share name+DOB+sex with different MRNs
  suspectGroupId String?
  source         String     @default("seed")
  rawImportJson  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  specimens      Specimen[]

  @@index([lastName, firstName])
  @@index([suspectGroupId])
  @@index([status])
  @@index([syncStatus])
}

model Specimen {
  id                     String    @id @default(cuid())
  accessionNumber        String    @unique
  barcode                String    @unique
  patientId              String?
  patientJson            String?
  /// Audit of identity confirmation when patient was in a suspect group
  identityConfirmationJson String?
  specimenType           String    @default("blood")
  orderedTestsJson       String    @default("[]")
  /// Point-in-time missing-result snapshot acknowledged at last submit.
  submitMissingExpectedJson String?
  /// Cloud requisition id when reception created an order before accession.
  requisitionId          String?
  status                 String    @default("registered")
  collectedAt            DateTime?
  registeredAt           DateTime  @default(now())
  registeredBy           String?
  registeredBySnapshot   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  results                Result[]
  patient                Patient?  @relation(fields: [patientId], references: [id])

  @@index([barcode])
  @@index([patientId])
}

model Result {
  id              String   @id @default(cuid())
  accessionNumber String
  barcode         String
  analyzerId      String
  testCode        String
  /// Catalog order line this result fulfills (especially manual components).
  orderedTestCode String?
  /// Stable component key for multi-part/hybrid manual observations.
  resultComponentCode String?
  /// Raw instrument code before remap to catalog testCode.
  instrumentTestCode String?
  testName        String?
  value           String
  units           String?
  referenceLow    Float?
  referenceHigh   Float?
  flag            String   @default("unknown")
  /// Clinical release workflow: pending_review → pending_authorization → released
  status          String   @default("pending_review")
  submittedAt     DateTime?
  submittedBy     String?
  /// JSON ActorSnapshot at submit time
  submittedBySnapshot String?
  releasedAt      DateTime?
  releasedBy      String?
  releasedBySnapshot  String?
  observedAt      DateTime
  rawMessageId    String?
  /// Authenticated staff attribution for manually entered results.
  manualEnteredBy String?
  manualEnteredBySnapshot String?
  manualEnteredAt DateTime?
  manualLastEditedBy String?
  manualLastEditedBySnapshot String?
  manualLastEditedAt DateTime?
  createdAt       DateTime @default(now())
  specimen        Specimen? @relation(fields: [accessionNumber], references: [accessionNumber])
  rawMessage      RawMessage? @relation(fields: [rawMessageId], references: [id])

  @@index([barcode])
  @@index([analyzerId])
  @@index([status])
  @@index([accessionNumber, testCode, analyzerId])
}

model RawMessage {
  id          String   @id @default(cuid())
  analyzerId  String
  transport   String
  protocol    String
  payload     String
  receivedAt  DateTime @default(now())
  parsedOk    Boolean  @default(false)
  parseError  String?
  results     Result[]

  @@index([analyzerId, receivedAt])
}

model OutboxEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  type       String
  status     String   @default("pending")
  sequence   Int
  payload    String
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, sequence])
}

model SyncMeta {
  id    String @id @default("singleton")
  /// Monotonic sequence for outbox ordering
  nextSequence Int @default(1)
  /// YYYYMMDD for sequential accession counter
  accessionDay String @default("")
  accessionSeq Int    @default(0)
}

/// Lab staff account — created on the edge (lab PC), never on cloud.
/// `id` is a client-generated UUID that becomes the Supabase `auth.users.id`
/// / `profiles.id` once synced, so edge and cloud always agree on identity.
model Staff {
  id                String    @id
  email             String    @unique
  passwordHash      String
  fullName          String
  /// tech | authorizer | admin
  role              String
  /// StaffJobTitle enum value (see packages/contracts)
  jobTitle          String?
  isActive          Boolean   @default(true)
  /// Derived from role: true for admin/authorizer, false for tech.
  cloudLoginAllowed Boolean   @default(false)
  /// pending | synced | failed — outbox push status for this staff row.
  syncStatus        String    @default("pending")
  passwordChangedAt DateTime  @default(now())
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([role])
  @@index([syncStatus])
}

/// One-time code an edge admin issues so a specific staff member can enroll
/// their browser as a "lab-issued device" for cloud login. Short-lived; the
/// authoritative copy lives on the cloud (`device_enrollment_codes`) once
/// pushed — this row is the edge's local record for audit/troubleshooting.
model DeviceEnrollmentCode {
  id               String    @id @default(cuid())
  codeHash         String    @unique
  assignToStaffId  String
  createdByStaffId String?
  deviceLabel      String?
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([expiresAt])
}

/// Append-only clinical audit trail (WORM on edge).
model AuditEvent {
  id           String   @id @default(cuid())
  occurredAt   DateTime @default(now())
  eventType    String
  entityType   String
  entityId     String
  actorUserId  String?
  actorSnapshot String?
  payload      String   @default("{}")
  edgeNodeId   String?

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([eventType])
}
