# Edge engine — key catalog for Doppler (drax-lis / dev).
# Runtime secrets come from `doppler run`, not this file.
# Prefer EDGE_ENGINE_PORT over PORT in a shared Doppler config.

EDGE_ENGINE_PORT=3101
DATABASE_URL=file:./dev.db
EDGE_NODE_ID=drax-hall-edge-1
CLOUD_API_URL=http://localhost:3102
CLOUD_SYNC_ENABLED=true
SYSMEX_TCP_PORT=5001
MINDRAY_TCP_PORT=5003
IFLASH_TCP_PORT=5004
PROLYTE_SERIAL_PATH=
PROLYTE_BAUD=9600
PROLYTE_BLOCK_IDLE_MS=400
SYSMEX_SERIAL_PATH=
ZEBRA_PRINTER_HOST=127.0.0.1
ZEBRA_PRINTER_PORT=9100
LABEL_WIDTH_DOTS=406
LABEL_HEIGHT_DOTS=203
LABEL_COPIES=1
SYNC_CRON=*/15 * * * * *
# Must match API EDGE_SYNC_TOKEN
EDGE_SYNC_TOKEN=
