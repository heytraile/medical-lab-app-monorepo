# Edge engine — key catalog for Doppler (drax-lis / dev).
# Runtime secrets come from `doppler run`, not this file.
# Prefer EDGE_ENGINE_PORT over PORT in a shared Doppler config.

EDGE_ENGINE_PORT=3101
DATABASE_URL=file:./dev.db
EDGE_NODE_ID=drax-hall-edge-1
CLOUD_API_URL=http://localhost:3102
CLOUD_SYNC_ENABLED=true
SYSMEX_TCP_PORT=5001
MINDRAY_TCP_PORT=5003
IFLASH_TCP_PORT=5004
PROLYTE_SERIAL_PATH=
PROLYTE_BAUD=9600
PROLYTE_BLOCK_IDLE_MS=400
SYSMEX_SERIAL_PATH=
ZEBRA_PRINTER_HOST=127.0.0.1
ZEBRA_PRINTER_PORT=9100
LABEL_SIZE_ID=tube_2x1
LABEL_WIDTH_DOTS=406
LABEL_HEIGHT_DOTS=203
LABEL_COPIES=1
SYNC_CRON=*/15 * * * * *
# Must match API EDGE_SYNC_TOKEN
EDGE_SYNC_TOKEN=

# --- Lab production hardening (see docs/EDGE_SECURITY_AND_BACKUP.md) ---
# EDGE_HARDENING=true
# CORS_ORIGINS=http://lab-pc.local:3101
# BACKUP_DIR=/backups
# BACKUP_RETENTION_DAYS=7
# BACKUP_INTERVAL_MINUTES=30

# --- Edge-first staff auth (see docs/EDGE_AUTH_AND_STAFF.md) ---
# Signs/verifies edge login sessions. REQUIRED when EDGE_HARDENING=true.
# Generate with: openssl rand -hex 32
# EDGE_JWT_SECRET=
# Set to "false" to skip auto-seeding the 7 dev/demo staff accounts (bootstrap-admin only).
# EDGE_STAFF_SEED=true
