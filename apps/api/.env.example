# Cloud API — key catalog for Doppler (drax-lis / dev).
# Runtime secrets come from `doppler run`, not this file.
# Prefer API_PORT over PORT in a shared Doppler config.

API_PORT=3102
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required for validating browser JWTs on cloud routes (same as web anon key)
SUPABASE_ANON_KEY=
# Shared secret for edge → cloud sync (same value on edge)
EDGE_SYNC_TOKEN=
# Edge bridge URL — cloud API reads released bench rows for Ready to send reconcile
EDGE_API_URL=
# Local report email → Mailpit (supabase start). Production → Resend — see docs/EMAIL.md
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_FROM=Drax Hall Lab <lab@draxhall.local>
# RESEND_API_KEY=          # production/staging only (Doppler)
# REVIEW_ALERT_EMAIL_FROM= # production/staging only (Doppler)
# When Supabase is unset, sync events + clinical projection use in-memory store.

# --- Edge-first staff auth + device enrollment (see docs/EDGE_AUTH_AND_STAFF.md) ---
# No new env vars here — staff signup lives on the edge (EDGE_JWT_SECRET) and
# is pushed to this API via the existing EDGE_SYNC_TOKEN channel above. The
# custom_access_token_hook (blocks tech cloud login) is a Postgres function —
# see supabase/migrations/20260905000000_edge_auth_and_devices.sql and, for
# hosted Supabase, Dashboard → Authentication → Hooks.
