# Cloud API — key catalog for Doppler (drax-lis / dev).
# Runtime secrets come from `doppler run`, not this file.
# Prefer API_PORT over PORT in a shared Doppler config.

API_PORT=3102
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for edge → cloud sync (same value on edge)
EDGE_SYNC_TOKEN=
# When Supabase is unset, sync events + clinical projection use in-memory store.
