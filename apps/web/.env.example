# Web (Vite) — key catalog for Doppler (drax-lis / dev).
# Only VITE_* keys are exposed to the browser. Set them in Doppler as VITE_….

VITE_LIS_API_URL=http://localhost:3101
VITE_LIS_MODE=edge
VITE_WS_URL=http://localhost:3101
VITE_CLOUD_API_URL=http://localhost:3102
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloud mode example (same Doppler config, change these values):
# VITE_LIS_MODE=cloud
# VITE_LIS_API_URL=http://localhost:3102
